pipeline {
    agent any

    environment {
        PATH = "/Users/keerthana/Desktop/cicd/cicd-demo/Dockerfile"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Docker Build') {
            steps {
                dir('cicd-demo') {
                    sh 'docker --version'
                    sh 'docker build -t cicd-demo:v1 .'
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('cicd-demo') {
                    sh 'kubectl version --client'
                    sh 'kubectl apply -f k8s/'
                }
            }
        }
    }
}